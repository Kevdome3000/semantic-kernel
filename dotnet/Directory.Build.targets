<Project>
    <!-- Direct all packages under 'dotnet' to get versions from Directory.Packages.props -->
    <!-- using Central Package Management feature -->
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.1.3"/>
    <!-- ChanceAI fork: 'dotnet format' on build is OPT-IN (-p:RunDotnetFormatOnBuild=true). Upstream ran it on
         every dev-machine Release build, which rewrote hundreds of tracked sources in this submodule whenever
         ChanceAI built Release (e.g. the sidecar publish/test scripts). -->
    <Target Name="DotnetFormatOnBuild" BeforeTargets="Build"
            Condition=" '$(RunDotnetFormatOnBuild)' == 'true' AND '$(GITHUB_ACTIONS)' == '' AND '$(TF_BUILD)' != 'true' ">
        <Message Text="Running dotnet format" Importance="high"/>
        <Exec Command="dotnet format --no-restore -v diag $(ProjectFileName)"/>
    </Target>
</Project>